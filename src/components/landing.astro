---
import '../styles/global.css';
import Picture01 from '../assets/pictures/picture_01.webp';
---

<section
   class="from-main to-main-dark flex h-[calc(100dvh-2.5rem)] w-full flex-row items-center bg-linear-to-b px-32"
>
   <div class="flex flex-col items-center justify-center">
      <p class="font-roboto text-7xl font-bold text-white uppercase italic">
         Potente desengrasante D'Grade
      </p>

      <ul
         class="[&>li]:text-custom-black mt-20 flex w-full flex-col gap-5 [&>li]:text-6xl [&>li]:font-bold [&>li]:uppercase [&>li]:italic"
      >
         <li>- Natural</li>
         <li>- Biodegradable</li>
         <li>- Fácil de usar</li>
      </ul>

      <button
         class="bg-custom-black hover:bg-contrast/40 mt-16 mr-auto cursor-pointer rounded-4xl px-8 py-3 text-2xl text-white transition-all"
         >Contactar</button
      >
   </div>
   <img
      src={Picture01.src}
      alt="Bottle"
      class="aspect-square h-7/10"
   />
</section>
