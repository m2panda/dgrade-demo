---
import PictureCompare from '@components/picture-compare.astro';

import HandAfter from '@pictures/1b200d53-41ab-485f-9f1d-7ee2534ce855.webp';
import MachineBefore from '@pictures/4ba8a5c4-ff8f-4ed3-82e6-c53f8825319c.webp';
import NatureAfter from '@pictures/5ffc1d54-152d-4dcd-8056-10ddf43965ce.webp';
import HandBefore from '@pictures/74a1d715-859f-4dc5-bc7f-e8c9ec5dcc5d.webp';
import NatureBefore from '@pictures/8e352a55-8c91-4498-9724-7929b856af50.webp';
import MachineAfter from '@pictures/9e16a718-824b-4954-b8ee-f4e5baba2d04.webp';

const examples: {
   title: string;
   description: string;
   before: string;
   after: string;
}[] = [
   {
      title: 'Cuidado de la naturaleza',
      description:
         'Nuestro producto D’Grade al ser totalmente biodegradable e inocuo, cumple con las normas de calidad necesarias para eliminar los restos de grasa y aceite, es agresivo con la suciedad pero sin causar daño a los seres vivos tanto del reino animal como vegetal. Además de potentes, nuestros limpiadores no contaminan, no dañan tu piel ni tu salud. ',
      before: NatureBefore.src,
      after: NatureAfter.src,
   },
   {
      title: 'Uso en seres humanos',
      description:
         'Además de ser un potente agente desengrasante, podemos ver como es fácil de usar para la limpieza de manos, sin dañar la piel y sin contaminar al medio ambiente.',
      before: HandBefore.src,
      after: HandAfter.src,
   },
   {
      title: 'Equipo industrial',
      description:
         'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean sit amet dui non ante imperdiet vulputate a vel ante. Integer urna odio, posuere at orci vel, pretium tempus dui. Pellentesque in hendrerit nisi. Duis sollicitudin nunc justo, vel semper mauris pulvinar id. Sed egestas, turpis eu volutpat cursus, tortor justo auctor massa, vel pharetra augue nibh in ligula.',
      before: MachineBefore.src,
      after: MachineAfter.src,
   },
];
---

<section
   id="examples"
   class="bg-custom-black flex w-full flex-col items-center gap-10 px-4 py-8 sm:px-12 sm:py-12 md:px-24"
>
   <h2
      class="border-main-dark w-full border-b-4 pb-4 text-center text-xl font-bold text-white italic transition-all duration-200 ease-linear sm:text-2xl xl:text-3xl"
   >
      Ejemplos
   </h2>

   <div class="bg-custom-black flex w-full flex-col items-center gap-16">
      {
         examples.map(
            (
               example: {
                  title: string;
                  description: string;
                  before: string;
                  after: string;
               },
               i: number,
            ) => (
               <article class="flex w-full flex-col items-center gap-10">
                  <h3 class="border-contrast w-full border-b-4 pb-2 text-left text-lg font-bold text-white italic transition-all duration-200 ease-linear sm:text-xl xl:text-2xl">
                     {example.title}
                  </h3>
                  <div
                     class={`flex w-full flex-col gap-6 ${i % 2 === 0 ? 'lg:flex-row lg:justify-between' : 'lg:flex-row-reverse lg:justify-end'}`}
                  >
                     <p class="w-full text-center text-base text-white transition-all duration-200 ease-linear lg:w-1/2 lg:text-left lg:text-lg 2xl:w-1/3">
                        {example.description}
                     </p>

                     <PictureCompare
                        imgBefore={example.before}
                        imgAfter={example.after}
                     />
                  </div>
               </article>
            ),
         )
      }
   </div>
</section>

<script>
   import '@scripts/picture-compare.ts';
</script>
