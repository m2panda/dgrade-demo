---
import FacebookIcon from '@icons/facebook-square.svg';
import PhoneIcon from '@icons/phone.svg';
---

<footer
   class="bg-main ease flex w-full flex-col items-center justify-between gap-2 px-4 py-8 transition-all duration-200 sm:flex-row sm:gap-0 sm:px-12 sm:py-2 md:px-24"
>
   <span class="text-white">Desarrollado por <b>FromIndustries</b></span>
   <ul class="flex w-fit flex-row gap-2 [&>li]:flex">
      <li>
         <a
            href="tel:+527710009090"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-end gap-2"
         >
            <span class="text-sm text-white">+52 771 000 9090</span>
            <img
               src={PhoneIcon.src}
               alt="Phone"
               class="size-8 invert-100"
            />
         </a>
      </li>
      <li>
         <a
            href="https://www.facebook.com/people/DGrade-Productos-de-Limpieza/61563966772161/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex"
         >
            <img
               src={FacebookIcon.src}
               alt="Facebook"
               class="size-8 invert-100"
            />
         </a>
      </li>
   </ul>
</footer>
