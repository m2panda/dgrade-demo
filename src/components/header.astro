---
import '../styles/global.css';
---

<header class="sticky top-0 z-50 flex h-10 w-full bg-white shadow">
   <aside class="m-0 flex h-full w-full items-center justify-center p-0">
      <ul
         class="[&>li>button]:text-main flex flex-row items-center justify-center gap-10 [&>li>button]:cursor-pointer [&>li>button]:font-bold [&>li>button]:transition-all [&>li>button]:hover:underline"
      >
         <li><button>Áreas</button></li>
         <li><button>Ejemplos</button></li>
         <li><button>Nosotros</button></li>
         <li><button>Contactanos</button></li>
      </ul>
   </aside>
</header>
