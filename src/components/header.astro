---
import Logo from '@icons/logo.svg';

const headerLinks: { name: string; href: string }[] = [
   { name: 'Ejemplos', href: '#examples' },
   { name: 'Áreas', href: '#areas' },
   { name: 'Nosotros', href: '#about' },
   { name: 'Contactanos', href: '#contact' },
];
---

<header
   class="sticky top-0 z-50 flex h-14 w-full items-center justify-between bg-white px-32 shadow"
>
   <a
      href="/"
      class="flex items-center justify-center"
   >
      <img
         src={Logo.src}
         alt="Logo"
         class="flex size-14 min-w-14"
      />
   </a>

   <aside class="m-0 flex h-full items-center justify-center p-0">
      <ul
         class="[&_a]:text-main flex flex-row items-center justify-center gap-10 [&_a]:cursor-pointer [&_a]:font-bold [&_a]:transition-all [&_a]:hover:underline"
      >
         {
            headerLinks.map((link: { name: string; href: string }) => (
               <li>
                  <a href={link.href}>{link.name}</a>
               </li>
            ))
         }
      </ul>
   </aside>
</header>
