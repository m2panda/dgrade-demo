---
import EnvelopeIcon from '@icons/envelope-alt.svg';
import FacebookIcon from '@icons/facebook-square.svg';
import PhoneIcon from '@icons/phone.svg';

const links: {
   href: string;
   text: string;
   icon: string;
}[] = [
   {
      href: 'mailto:example@dgrade.mx',
      text: 'example@dgrade.mx',
      icon: EnvelopeIcon.src,
   },
   {
      href: 'tel:+527710009090',
      text: '+52 771 000 9090',
      icon: PhoneIcon.src,
   },
   {
      href: 'https://www.facebook.com/people/DGrade-Productos-de-Limpieza/61563966772161/',
      text: 'Facebook oficial',
      icon: FacebookIcon.src,
   },
];
---

<button
   id="floating-contact-button"
   class="bg-custom-black fixed right-10 bottom-8 z-30 flex aspect-square w-16 cursor-pointer items-center justify-center rounded-full"
>
   <img
      src={PhoneIcon.src}
      alt="Phone"
      class="svg-to-contrast size-7 animate-pulse transition-all duration-200 sm:size-8"
   />
</button>

<ul
   id="floating-contact"
   class="floating-contact-closed fixed right-10 bottom-26 z-30 flex w-fit origin-bottom-right flex-col items-end justify-start gap-3 rounded-3xl bg-white p-4 shadow transition-all duration-200 ease-linear"
>
   {
      links.map((link: { href: string; text: string; icon: string }) => (
         <li class="flex flex-row items-center justify-center gap-2">
            <a
               href={link.href}
               target="_blank"
               rel="noopener noreferrer"
               class="hover:text-main text-custom-black flex underline transition-all duration-200"
            >
               {link.text}
            </a>

            <img
               src={link.icon}
               alt={link.text}
               class="svg-to-main size-6"
            />
         </li>
      ))
   }
</ul>

<script>
   document.addEventListener('DOMContentLoaded', () => {
      const floatingContact = document.getElementById('floating-contact');
      const floatingContactButton = document.getElementById(
         'floating-contact-button',
      );

      if (!floatingContact || !floatingContactButton) return;

      floatingContactButton.addEventListener('click', () => {
         floatingContact.classList.toggle('floating-contact-open');
         floatingContact.classList.toggle('floating-contact-closed');
      });
   });
</script>
