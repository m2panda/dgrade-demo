---
import CarIcon from '@icons/car.svg';
import ChefHatIcon from '@icons/chef-hat.svg';
import FactoryIcon from '@icons/factory.svg';
import Cook from '@pictures/983d6e1d-1faf-4627-833e-28051743568b.webp';
import Workshop from '@pictures/cdcb4386-598d-4e36-9040-8f2766955804.webp';
import Industry from '@pictures/fa9129c2-5dea-4e88-9b1f-9eddc27b3195.webp';

const areas: {
   title: string;
   picture: string;
   icon: string;
}[] = [
   {
      title: 'Talleres y áreas de trabajo',
      picture: Workshop.src,
      icon: CarIcon.src,
   },
   {
      title: 'Limpieza de cocinas',
      picture: Cook.src,
      icon: ChefHatIcon.src,
   },
   {
      title: 'Tanques de combustibles',
      picture: Industry.src,
      icon: FactoryIcon.src,
   },
];
---

<section
   id="areas"
   class="flex w-full flex-col items-center overflow-hidden bg-white"
>
   <h2
      class="text-custom-black border-main-dark my-8 w-[calc(100%-2rem)] border-b-4 pb-4 text-center text-xl font-bold italic transition-all duration-200 ease-linear sm:my-12 sm:w-[calc(100%-6rem)] sm:text-2xl md:w-[calc(100%-12rem)] xl:text-3xl"
   >
      Áreas
   </h2>
   <div class="flex flex-col lg:h-screen lg:flex-row">
      {
         areas.map((area: { title: string; picture: string; icon: string }) => (
            <article class="relative flex h-[80dvh] w-full items-center justify-center overflow-hidden lg:h-screen lg:w-1/3 lg:max-w-1/3 [&>div]:bg-black/0 hover:[&>div]:bg-black/0 lg:[&>div]:bg-black/30 [&>div>div]:opacity-100 hover:[&>div>div]:opacity-100 lg:[&>div>div]:opacity-80 [&>img]:scale-100 hover:[&>img]:scale-105">
               <img
                  src={area.picture}
                  alt={area.title}
                  class="size-full object-cover transition-all duration-200 ease-linear"
               />
               <div class="absolute top-0 left-0 z-10 flex size-full flex-col items-center justify-end px-4 py-8 transition-all duration-200 ease-linear sm:py-12">
                  <div class="bg-main flex items-center justify-start gap-5 rounded-4xl py-3 pr-6 pl-3">
                     <div class="rounded-full bg-white p-2">
                        <img
                           src={area.icon}
                           alt="area-icon"
                           class="svg-to-main size-5"
                        />
                     </div>
                     <span class="font-bold text-white">{area.title}</span>
                  </div>
               </div>
            </article>
         ))
      }
   </div>
</section>
