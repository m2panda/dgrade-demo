{
   "extends": "astro/tsconfigs/strict",
   "exclude": ["dist"],
   "include": [".astro/types.d.ts", "src/**/*.astro", "src/**/*.ts"],
   "compilerOptions": {
      "paths": {
         "@components/*": ["./src/components/*"],
         "@styles/*": ["./src/styles/*"],
         "@icons/*": ["./src/assets/icons/*"],
         "@pictures/*": ["./src/assets/pictures/*"]
      }
   }
}
